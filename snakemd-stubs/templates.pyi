import os
from abc import ABCMeta
from collections.abc import Iterable
from enum import Enum

from .elements import Block, Element, Inline

class Template(Element, metaclass=ABCMeta):
    def __init__(self) -> None: ...
    def load(self, elements: list[Element]) -> None: ...

class Alert(Template):
    class Kind(Enum):
        NOTE = 1
        TIP = 2
        IMPORTANT = 3
        WARNING = 4
        CAUTION = 5

    def __init__(self, message: str | Iterable[str | Inline | Block], kind: Alert.Kind) -> None: ...
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...

class Checklist(Template):
    def __init__(
        self,
        items: Iterable[str | Inline | Block],
        checked: bool | Iterable[bool] = False,
    ) -> None: ...
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...

class CSVTable(Template):
    def __init__(self, path: str | os.PathLike[str], encoding: str = "utf-8") -> None: ...
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...

class TableOfContents(Template):
    def __init__(self, levels: range = range(2, 3)) -> None: ...
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...
